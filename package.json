{
  "name": "boltsense",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "test": "npm run test -w server",
    "check:models": "node scripts/check-twin-coverage.mjs",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": { "concurrently": "^9.1.2" },
  "engines": { "node": ">=20" }
}

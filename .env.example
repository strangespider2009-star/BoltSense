# The web client defaults to demo mode, with no hardware required.
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
# Backend (copy this file to .env at repository root)
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATA_MODE=demo
DATABASE_URL=postgresql://boltsense:boltsense_dev_only@localhost:5432/boltsense?schema=public
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Set a long random signing secret and valid bcrypt hash before enabling privileged endpoints.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# 15 seconds without telemetry marks a sensor as stale.
SENSOR_STALE_MS=15000
